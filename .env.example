# MySQL 连接（本地 docker compose 默认值；生产经部署注入，勿提交真实凭据）
# 独立 STORAGE_* 优先；缺省回退到共享 MYSQL_*（可与 session-persistence/credentials 同库共存）。
STORAGE_HOST=127.0.0.1
STORAGE_PORT=3306
STORAGE_USER=dsh
STORAGE_PASSWORD=dsh_dev_password
STORAGE_DATABASE=dsh_storage
STORAGE_TABLE_PREFIX=dsh_stor_

# 测试隔离：自动化测试用独立库，不触碰生产库
STORAGE_TEST_DATABASE=test
# root 密码：仅供测试启动引导测试库（建库+授权），插件本身不用。
MYSQL_ROOT_PASSWORD=root_dev_password

# schema 自动迁移：true=启动幂等建表+版本校验；false=只校验
STORAGE_SCHEMA_AUTO_MIGRATE=true

# TLS（暂缓，保留配置位；届时可能由云服务商提供）
STORAGE_SSL_REQUIRED=false

# 连接池
STORAGE_POOL_SIZE=10
STORAGE_POOL_QUEUE_LIMIT=0
